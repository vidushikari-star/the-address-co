# Copy to .env.e2e.local. This file deliberately contains names only: never
# commit values, credentials, project references, or production identifiers.
#
# The runner refuses to start until the Supabase Management API verifies that
# E2E_SUPABASE_PROJECT_REF and E2E_EXPECTED_PROJECT_NAME identify a disposable
# project and that it differs from the known production project.
E2E_ALLOW_DESTRUCTIVE_TESTS=false
E2E_SUPABASE_URL=
E2E_SUPABASE_PROJECT_REF=
E2E_EXPECTED_PROJECT_NAME=
E2E_SUPABASE_MANAGEMENT_TOKEN=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Local is the recommended test app target. A non-local URL is accepted only
# when its hostname clearly identifies a test, staging, or disposable app.
E2E_BASE_URL=http://127.0.0.1:3100
E2E_START_LOCAL_APP=true
E2E_APP_PORT=3100

# These must name the real production target so the guard can prove it is not
# the target of a destructive test run. Keep their values local-only.
E2E_KNOWN_PRODUCTION_PROJECT_REF=
E2E_KNOWN_PRODUCTION_SUPABASE_URL=
E2E_KNOWN_PRODUCTION_APP_URL=

# Dedicated, non-human accounts in the disposable Supabase project only.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SALES_EMAIL=
E2E_SALES_PASSWORD=
E2E_UNPROFILED_EMAIL=
E2E_UNPROFILED_PASSWORD=

# Optional traceability label. If blank, the runner generates a unique value.
E2E_RUN_ID=

# Enables the mutation smoke-plan suite once its per-workflow fixture mappings
# have been completed. It does not weaken the target safety checks.
E2E_ENABLE_FULL_STAGE1_SMOKE=false
