# Copy to .env.marketing-qa.local. Do not commit the local file or put any
# production identifiers, credentials, Instagram tokens, or real inventory in it.
#
# `npm run marketing:qa` verifies the named project through the Supabase
# Management API, verifies the dedicated admin profile, and fails closed unless
# every safety switch below is set exactly as required.

MARKETING_QA_SUPABASE_URL=
MARKETING_QA_SUPABASE_PROJECT_REF=
MARKETING_QA_EXPECTED_PROJECT_NAME=
MARKETING_QA_SUPABASE_MANAGEMENT_TOKEN=
MARKETING_QA_SUPABASE_ANON_KEY=
# Used only by the preflight to verify that the QA login has an admin profile.
MARKETING_QA_SUPABASE_SERVICE_ROLE_KEY=

MARKETING_QA_BASE_URL=http://127.0.0.1:3101
MARKETING_QA_APP_PORT=3101

# The verifier compares all three identity signals and rejects any match.
MARKETING_QA_KNOWN_PRODUCTION_PROJECT_REF=
MARKETING_QA_KNOWN_PRODUCTION_SUPABASE_URL=
MARKETING_QA_KNOWN_PRODUCTION_APP_URL=

# A pre-existing dedicated admin in the verified non-production project.
# The launcher never creates or changes users.
MARKETING_QA_ADMIN_EMAIL=
MARKETING_QA_ADMIN_PASSWORD=

# Required, fail-closed QA mode. Do not change these values.
MARKETING_QA_ENABLED=true
MARKETING_QA_PUBLISHING_ENABLED=false
MARKETING_QA_SCHEDULING_ENABLED=false
